# С доменом: автоматический HTTPS (Let's Encrypt), редирект http→https и wss://.
# DNS A-запись farmclash.online должна указывать на IP сервера, порты 80 и 443 — открыты.
farmclash.online {
	reverse_proxy game:3000
}

# Без домена (играть по IP, ws:// без шифрования) — раскомментируйте вместо блока выше:
# :80 {
# 	reverse_proxy game:3000
# }
