# Extend the existing GPU image and retain it for rollback.
FROM photo-worker:local
USER root
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then export SSL_CERT_FILE=/run/secrets/build_ca; fi; \
    uv sync --frozen --no-dev --extra gpu --extra flux-lora --no-cache
COPY --chown=10001:10001 photo_service ./photo_service
COPY --chown=10001:10001 scripts/start-gpu.sh ./scripts/start-gpu.sh
COPY --chown=10001:10001 scripts/gpu_probe.py ./scripts/gpu_probe.py
COPY --chown=10001:10001 scripts/lora_probe.py ./scripts/lora_probe.py
ENV ENGINE=flux_lora FLUX1_MODEL_DIR=/models/flux1-dev HEARTSYNC_LORA_DIR=/models/heartsync-flux1
USER app
