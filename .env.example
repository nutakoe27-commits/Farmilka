# Run `python scripts/init_env.py` to create .env with random access tokens.
API_TOKEN=
WORKER_TOKEN=
DATA_DIR=./data
CONTROL_URL=http://127.0.0.1:8000
ENGINE=mock
MODEL_DIR=./models/flux2-klein-4b
MODEL_CPU_OFFLOAD=true
# Qwen is selected by compose.qwen-gguf.yaml / scripts/qwen.sh on the GPU VM.
QWEN_MODEL_DIR=./models/qwen-image-2.1-turbo
QWEN_LOAD_TIMEOUT=1200
QWEN_JOB_TIMEOUT=1200
