# Токен доступа к админ-панели /admin/stats?token=...
# Придумайте свой длинный случайный токен!
ADMIN_TOKEN=change-me

# Сколько ботов-«наполнителей» держать на каждом мире (0 — выключить).
# Они не считаются в статистике, лидерборде и лимите игроков.
BOTS_PER_WORLD=5

# Яндекс.Игры: секрет из Консоли разработчика для проверки подписи игрока.
# Пока не заполнен — вход через Яндекс принимается без проверки подписи
# (нормально для теста по URL до публикации). Для строгой проверки:
#   1) укажите секрет здесь, 2) выставьте YANDEX_VERIFY_SIG=1.
YANDEX_GAME_SECRET=
YANDEX_VERIFY_SIG=0
